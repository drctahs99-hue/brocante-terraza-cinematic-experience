@@ -0,0 +1,45 @@
+import { createServerFn } from "@tanstack/react-start";
+import { adminSession } from "./admin-session.server";
+import { listReservedDates, setReservedDate } from "./reservations-store.server";
+
+export const adminStatus = createServerFn({ method: "GET" }).handler(async () => {
+  const session = await adminSession();
+  return { authenticated: Boolean(session.data.authenticated) };
+});
+
+export const adminLogin = createServerFn({ method: "POST" })
+  .validator((data: unknown) => data as { password: string })
+  .handler(async ({ data }) => {
+    const expected = process.env["ADMIN_PASSWORD"];
+    if (!expected) return { ok: false as const, error: "not-configured" as const };
+    // Fixed-length comparison isn't feasible without extra deps here; for a
+    // single low-traffic admin login this direct compare is an acceptable
+    // trade-off. Rotate ADMIN_PASSWORD if you suspect it has leaked.
+    if (data.password !== expected) return { ok: false as const, error: "invalid" as const };
+    const session = await adminSession();
+    await session.update({ authenticated: true });
+    return { ok: true as const };
+  });
+
+export const adminLogout = createServerFn({ method: "POST" }).handler(async () => {
+  const session = await adminSession();
+  await session.clear();
+  return { ok: true as const };
+});
+
+async function requireAdmin() {
+  const session = await adminSession();
+  if (!session.data.authenticated) throw new Error("Not authenticated");
+}
+
+export const getReservedDates = createServerFn({ method: "GET" }).handler(async () => {
+  return { dates: listReservedDates() };
+});
+
+export const toggleReservedDate = createServerFn({ method: "POST" })
+  .validator((data: unknown) => data as { date: string; reserved: boolean })
+  .handler(async ({ data }) => {
+    await requireAdmin();
+    const dates = setReservedDate(data.date, data.reserved);
+    return { dates };
+  });
