--- /dev/null
+++ b/src/lib/admin-session.server.ts
@@ -0,0 +1,26 @@
+import { useSession } from "@tanstack/react-start/server";
+
+type AdminSessionData = { authenticated?: boolean };
+
+function sessionSecret() {
+  const secret = process.env["ADMIN_SESSION_SECRET"];
+  if (!secret || secret.length < 32) {
+    // Fails loudly on purpose: a short/missing secret would make the
+    // session trivial to forge. Set a real 32+ character random string as
+    // the ADMIN_SESSION_SECRET environment variable on the hosting platform.
+    throw new Error("ADMIN_SESSION_SECRET must be set to a random string of 32+ characters.");
+  }
+  return secret;
+}
+
+// Encrypted, signed, httpOnly session cookie (TanStack Start's built-in
+// sealed-session mechanism). The password itself is never stored in the
+// cookie, and the cookie cannot be forged without ADMIN_SESSION_SECRET.
+export function adminSession() {
+  return useSession<AdminSessionData>({
+    password: sessionSecret(),
+    name: "brocante-admin",
+    maxAge: 60 * 60 * 8,
+    cookie: { httpOnly: true, sameSite: "lax", secure: true, path: "/" },
+  });
+}
