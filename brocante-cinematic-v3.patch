--- /dev/null
+++ b/src/lib/reservations-store.server.ts
@@ -0,0 +1,27 @@
+// MVP storage for reserved dates: kept in the server process memory.
+//
+// This works correctly while the server instance stays alive (fine for
+// trying this out and for a low-traffic site on a traditional Node host).
+// On a serverless / edge platform (Cloudflare Workers, most "Lovable"
+// deployments included) each cold start gets a fresh empty Map — reserved
+// dates would reset on redeploy or after periods of inactivity.
+//
+// To make this durable and shared across every server instance, swap the
+// three functions below for calls to a real store — the rest of the app
+// never needs to change:
+//   - Cloudflare KV (best fit if deploying to Cloudflare: free tier, a
+//     couple of lines using the KV binding already available to Nitro)
+//   - Supabase (a `reserved_dates` table, free tier, also gives the CEO
+//     login for free via Supabase Auth instead of the single shared
+//     password used here)
+const reserved = new Set<string>();
+
+export function listReservedDates(): string[] {
+  return Array.from(reserved).sort();
+}
+
+export function setReservedDate(date: string, isReserved: boolean) {
+  if (isReserved) reserved.add(date);
+  else reserved.delete(date);
+  return listReservedDates();
+}
