+++ b/src/components/brocante/phases.ts
@@ -0,0 +1,21 @@
+export type Phase = { key: string; end: number; textStart: number; title: string; cta?: boolean };
+
+// One continuous shot, divided into content phases. The headline for a
+// phase only appears near the *end* of that phase's window (textStart),
+// once the camera has settled on what the text is talking about.
+export const phases: Phase[] = [
+  { key: "arrival", end: 0.4, textStart: 0.27, title: "L'Art de Recevoir." },
+  { key: "detail", end: 0.75, textStart: 0.63, title: "La Belleza en el Detalle." },
+  { key: "finale", end: 1.01, textStart: 0.89, title: "Vivan la Experiencia.", cta: true },
+];
+
+export function activePhaseIndex(progress: number) {
+  const index = phases.findIndex((phase) => progress < phase.end);
+  return index === -1 ? phases.length - 1 : index;
+}
+
+export function isTextVisible(progress: number, index: number) {
+  const phase = phases[index];
+  if (!phase) return false;
+  return progress >= phase.textStart && progress < phase.end;
+}
