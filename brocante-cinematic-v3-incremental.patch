index 0000000..bd6a094
--- /dev/null
+++ b/src/routes/reservas-admin-2a91f.tsx
@@ -0,0 +1,122 @@
+import { createFileRoute } from "@tanstack/react-router";
+import { useEffect, useState } from "react";
+import { Lock, LogOut, ShieldCheck } from "lucide-react";
+import { Button } from "@/components/ui/button";
+import { adminLogin, adminLogout, adminStatus, getReservedDates, toggleReservedDate } from "@/lib/admin.server";
+
+// Deliberately not linked from anywhere in the site's navigation. The path
+// itself is not the security boundary (see the server-side session check in
+// admin.server.ts) — it just keeps this out of casual reach.
+export const Route = createFileRoute("/reservas-admin-2a91f")({
+  head: () => ({ meta: [{ title: "Panel privado · Brocante Terraza" }, { name: "robots", content: "noindex, nofollow" }] }),
+  component: AdminPage,
+});
+
+function monthGrid(monthOffset: number) {
+  const now = new Date();
+  const month = new Date(now.getFullYear(), now.getMonth() + monthOffset, 1);
+  const days = new Date(month.getFullYear(), month.getMonth() + 1, 0).getDate();
+  const lead = (new Date(month.getFullYear(), month.getMonth(), 1).getDay() + 6) % 7;
+  return { month, days, lead };
+}
+
+function iso(y: number, m: number, d: number) {
+  return `${y}-${String(m + 1).padStart(2, "0")}-${String(d).padStart(2, "0")}`;
+}
+
+function AdminPage() {
+  const [checked, setChecked] = useState(false);
+  const [authed, setAuthed] = useState(false);
+  const [password, setPassword] = useState("");
+  const [error, setError] = useState<string | null>(null);
+  const [dates, setDates] = useState<Set<string>>(new Set());
+  const [busy, setBusy] = useState(false);
+
+  useEffect(() => {
+    adminStatus().then((res) => {
+      setAuthed(res.authenticated);
+      setChecked(true);
+    });
+  }, []);
+
+  useEffect(() => {
+    if (!authed) return;
+    getReservedDates().then((res) => setDates(new Set(res.dates)));
+  }, [authed]);
+
+  const login = async (event: React.FormEvent) => {
+    event.preventDefault();
+    setError(null);
+    setBusy(true);
+    const res = await adminLogin({ data: { password } }).finally(() => setBusy(false));
+    if (res.ok) {
+      setAuthed(true);
+      setPassword("");
+    } else if (res.error === "not-configured") {
+      setError("ADMIN_PASSWORD no está configurada en el servidor todavía.");
+    } else {
+      setError("Contraseña incorrecta.");
+    }
+  };
+
+  const toggle = async (date: string) => {
+    const nextReserved = !dates.has(date);
+    setDates((prev) => {
+      const next = new Set(prev);
+      if (nextReserved) next.add(date);
+      else next.delete(date);
+      return next;
+    });
+    await toggleReservedDate({ data: { date, reserved: nextReserved } });
+  };
+
+  if (!checked) return <div className="admin-shell admin-loading">Verificando sesión…</div>;
+
+  if (!authed) {
+    return (
+      <div className="admin-shell admin-login">
+        <form onSubmit={login} className="admin-login-card">
+          <Lock size={18} />
+          <h1>Panel privado</h1>
+          <p>Acceso exclusivo para la administración de Brocante Terraza.</p>
+          <input type="password" value={password} onChange={(event) => setPassword(event.target.value)} placeholder="Contraseña" autoFocus />
+          {error && <span className="admin-error">{error}</span>}
+          <Button type="submit" variant="luxury" size="luxury" disabled={busy}>{busy ? "Verificando…" : "Entrar"}</Button>
+        </form>
+      </div>
+    );
+  }
+
+  return (
+    <div className="admin-shell admin-dashboard">
+      <header>
+        <span><ShieldCheck size={16} /> Panel privado · Brocante Terraza</span>
+        <Button variant="ghost" size="sm" onClick={() => adminLogout().then(() => setAuthed(false))}><LogOut size={14} /> Salir</Button>
+      </header>
+      <p className="admin-hint">Marca una fecha como reservada para que desaparezca del calendario público. Vuelve a hacer clic para liberarla.</p>
+      <div className="admin-months">
+        {[0, 1, 2].map((offset) => {
+          const { month, days, lead } = monthGrid(offset);
+          return (
+            <article key={offset} className="admin-month">
+              <h3>{month.toLocaleDateString("es-MX", { month: "long", year: "numeric" })}</h3>
+              <div className="admin-days">
+                {Array.from({ length: lead }, (_, i) => <span key={`b-${i}`} />)}
+                {Array.from({ length: days }, (_, i) => {
+                  const d = i + 1;
+                  const dateIso = iso(month.getFullYear(), month.getMonth(), d);
+                  const isReserved = dates.has(dateIso);
+                  return (
+                    <button key={dateIso} type="button" className={isReserved ? "is-reserved" : ""} onClick={() => toggle(dateIso)}>
+                      {d}
+                    </button>
+                  );
+                })}
+              </div>
+            </article>
+          );
+        })}
+      </div>
+    </div>
+  );
+}
